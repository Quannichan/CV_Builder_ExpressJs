{
  "version": 2,
  "builds": [
    {
      "src": "src/index.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["public/**"] }
    }
  ],
  "routes": [
    {
        "src": "/api/be/images/(.*)",
        "headers": {
            "Access-Control-Allow-Origin": "https://cv-builder-reactjs.onrender.com",
            "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
            "Access-Control-Allow-Headers": "Origin, Content-Type, Accept, Tokenizer, Authorization",
            "Access-Control-Allow-Credentials": "true"
        },
        "continue": true
    },
    {
      "src": "/(.*)",
      "dest": "src/index.js"
    }
  ]
}